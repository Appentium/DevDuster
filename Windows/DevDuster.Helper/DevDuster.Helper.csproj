<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <AssemblyName>devduster-helper</AssemblyName>
    <!-- Native code has no CLR profiler or startup hooks, so user environment variables can't load code into the elevated process. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DevDuster.Core\DevDuster.Core.csproj" />
  </ItemGroup>
</Project>
