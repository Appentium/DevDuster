<UserControl
    x:Class="DevDuster.App.Shared.FooterBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:DevDuster.App.Shared">

    <Border
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
        BorderThickness="0,1,0,0"
        Padding="16,12">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button
                    Content="Select All"
                    Command="{x:Bind SelectAllCommand, Mode=OneWay}"
                    IsEnabled="{x:Bind CanSelectAll, Mode=OneWay}" />
                <Button
                    Content="Deselect All"
                    Command="{x:Bind DeselectAllCommand, Mode=OneWay}"
                    IsEnabled="{x:Bind CanDeselectAll, Mode=OneWay}" />
            </StackPanel>

            <TextBlock
                Grid.Column="2"
                VerticalAlignment="Center"
                Text="{x:Bind FormatSelection(SelectedCount, SelectedBytes), Mode=OneWay}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Visibility="{x:Bind shared:Ui.Collapsed(IsDeleting), Mode=OneWay}" />

            <StackPanel
                Grid.Column="1"
                Grid.ColumnSpan="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="{x:Bind shared:Ui.Visible(IsDeleting), Mode=OneWay}">
                <TextBlock
                    VerticalAlignment="Center"
                    Text="{x:Bind Progress.Text, Mode=OneWay}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ProgressBar
                    Width="260"
                    VerticalAlignment="Center"
                    Minimum="0"
                    Maximum="100"
                    Value="{x:Bind Progress.Percent, Mode=OneWay}" />
            </StackPanel>

            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ProgressRing
                    Width="20"
                    Height="20"
                    IsActive="{x:Bind ShowsSpinner, Mode=OneWay}"
                    Visibility="{x:Bind shared:Ui.Visible(ShowsSpinner), Mode=OneWay}" />
                <Button
                    Content="{x:Bind ActionTitle, Mode=OneWay}"
                    Style="{ThemeResource AccentButtonStyle}"
                    Command="{x:Bind CleanCommand, Mode=OneWay}"
                    IsEnabled="{x:Bind CanClean(SelectedCount, IsBusy), Mode=OneWay}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
