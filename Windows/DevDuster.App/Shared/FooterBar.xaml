<UserControl
    x:Class="DevDuster.App.Shared.FooterBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:DevDuster.App.Shared">

    <Border
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
        BorderThickness="0,1,0,0"
        Padding="16,12">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button
                    Content="Select All"
                    Command="{x:Bind SelectAllCommand, Mode=OneWay}"
                    IsEnabled="{x:Bind CanSelectAll, Mode=OneWay}" />
                <Button
                    Content="Deselect All"
                    Command="{x:Bind DeselectAllCommand, Mode=OneWay}"
                    IsEnabled="{x:Bind CanDeselectAll, Mode=OneWay}" />
            </StackPanel>

            <TextBlock
                Grid.Column="2"
                VerticalAlignment="Center"
                Text="{x:Bind FormatSelection(SelectedCount, SelectedBytes), Mode=OneWay}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ProgressRing
                    Width="20"
                    Height="20"
                    IsActive="{x:Bind IsBusy, Mode=OneWay}"
                    Visibility="{x:Bind shared:Ui.Visible(IsBusy), Mode=OneWay}" />
                <Button
                    Content="{x:Bind ActionTitle, Mode=OneWay}"
                    Style="{ThemeResource AccentButtonStyle}"
                    Command="{x:Bind CleanCommand, Mode=OneWay}"
                    IsEnabled="{x:Bind CanClean(SelectedCount, IsBusy), Mode=OneWay}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
