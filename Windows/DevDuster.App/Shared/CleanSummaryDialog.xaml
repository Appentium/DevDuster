<ContentDialog
    x:Class="DevDuster.App.Shared.CleanSummaryDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:clean="using:DevDuster.Core.Clean"
    xmlns:shared="using:DevDuster.App.Shared"
    Title="Clean Complete"
    CloseButtonText="OK"
    DefaultButton="Close">

    <StackPanel Spacing="12" MinWidth="440">
        <TextBlock
            Text="{x:Bind Headline}"
            Style="{ThemeResource SubtitleTextBlockStyle}" />

        <TextBlock
            Text="Space is only freed once that drive's Recycle Bin is emptied."
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap"
            Visibility="{x:Bind shared:Ui.Visible(ShowRecycleNote)}" />

        <StackPanel Spacing="6" Visibility="{x:Bind shared:Ui.VisibleWhenAny(Failures.Count)}">
            <TextBlock
                Text="{x:Bind FailuresHeader}"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                FontWeight="SemiBold" />
            <Border
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="4">
                <ListView
                    ItemsSource="{x:Bind Failures}"
                    SelectionMode="None"
                    MaxHeight="220">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="clean:CleanResult">
                            <StackPanel Spacing="2" Padding="4">
                                <TextBlock
                                    Text="{x:Bind Error}"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    TextWrapping="Wrap"
                                    Style="{ThemeResource CaptionTextBlockStyle}" />
                                <TextBlock
                                    Text="{x:Bind Item.Path}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind Item.Path}"
                                    Style="{ThemeResource CaptionTextBlockStyle}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </StackPanel>

        <Border
            x:Name="SharePrompt"
            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="12"
            Visibility="{x:Bind shared:Ui.Visible(ShowSharePrompt)}">
            <StackPanel Spacing="8">
                <TextBlock Text="Add your total to the DevDuster world counter?" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock
                    Text="Shares only a random ID, the platform, the app version and the total space freed. No paths or file names. You can turn it off in Settings."
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Share anonymously" Click="OnShareClicked" />
                    <Button Content="No thanks" Click="OnDeclineShareClicked" />
                    <HyperlinkButton Content="What is sent" NavigateUri="https://devduster.com/privacy.html#stats" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</ContentDialog>
