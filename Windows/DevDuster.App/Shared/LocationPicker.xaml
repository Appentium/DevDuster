<UserControl
    x:Class="DevDuster.App.Shared.LocationPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:DevDuster.App.Shared">

    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
        <ComboBox
            Header="Location"
            MinWidth="180"
            ItemsSource="{x:Bind Location.Options, Mode=OneWay}"
            SelectedIndex="{x:Bind Location.SelectedIndex, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="shared:LocationOption">
                    <TextBlock Text="{x:Bind Label}" ToolTipService.ToolTip="{x:Bind Path}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Content="Choose Folder..." VerticalAlignment="Bottom" Click="OnChooseFolderClicked" />
        <CheckBox
            Content="Remember"
            VerticalAlignment="Bottom"
            MinWidth="0"
            IsChecked="{x:Bind Location.Remember, Mode=TwoWay}"
            ToolTipService.ToolTip="Start from this location next time" />
    </StackPanel>
</UserControl>
