<Page
    x:Class="DevDuster.App.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:DevDuster.App.Shared"
    NavigationCacheMode="Required">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Settings" Style="{ThemeResource TitleTextBlockStyle}" Padding="24,16,24,12" />

        <ScrollViewer Grid.Row="1" Padding="24,0,24,24" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Stretch">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="General" Style="{ThemeResource SubtitleTextBlockStyle}" />

                        <ComboBox Header="Theme" SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}" MinWidth="200">
                            <ComboBoxItem Content="System" />
                            <ComboBoxItem Content="Light" />
                            <ComboBoxItem Content="Dark" />
                        </ComboBox>

                        <NumberBox
                            Header="Stale project threshold (days)"
                            Description="Project build folders are offered for cleaning once the project has no activity for this many days."
                            Minimum="1"
                            Maximum="365"
                            SpinButtonPlacementMode="Compact"
                            Width="240"
                            HorizontalAlignment="Left"
                            Value="{x:Bind ViewModel.StaleDaysValue, Mode=TwoWay}" />

                        <ToggleSwitch
                            Header="Keep DevDuster in the notification area"
                            IsOn="{x:Bind ViewModel.TrayEnabled, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Excluded Paths" Style="{ThemeResource SubtitleTextBlockStyle}" />

                        <TextBlock
                            Text="Nothing is excluded."
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Visibility="{x:Bind shared:Ui.Collapsed(ViewModel.HasExcluded), Mode=OneWay}" />

                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.ExcludedPaths}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="6" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <Button
                                            Grid.Column="1"
                                            Tag="{x:Bind}"
                                            Click="OnRemoveExcludedClicked"
                                            AutomationProperties.Name="Remove excluded path"
                                            ToolTipService.ToolTip="Remove">
                                            <SymbolIcon Symbol="Delete" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <Button Content="Add Folder..." Click="OnAddExcludedClicked" />
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Low Space Alerts" Style="{ThemeResource SubtitleTextBlockStyle}" />

                        <ToggleSwitch
                            Header="Notify when a drive runs low"
                            IsOn="{x:Bind ViewModel.LowSpaceAlertsEnabled, Mode=TwoWay}" />

                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <NumberBox
                                Header="System drive below (GB)"
                                Minimum="1"
                                Maximum="500"
                                SpinButtonPlacementMode="Compact"
                                Width="200"
                                Value="{x:Bind ViewModel.SystemThresholdGB, Mode=TwoWay}"
                                IsEnabled="{x:Bind ViewModel.LowSpaceAlertsEnabled, Mode=OneWay}" />
                            <NumberBox
                                Header="Other drives below (GB)"
                                Minimum="1"
                                Maximum="500"
                                SpinButtonPlacementMode="Compact"
                                Width="200"
                                Value="{x:Bind ViewModel.OtherThresholdGB, Mode=TwoWay}"
                                IsEnabled="{x:Bind ViewModel.LowSpaceAlertsEnabled, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Scheduled Clean" Style="{ThemeResource SubtitleTextBlockStyle}" />

                        <ToggleSwitch
                            Header="Clean the Safe tier on a schedule"
                            IsOn="{x:Bind ViewModel.ScheduledCleanEnabled, Mode=TwoWay}" />

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ComboBox
                                Header="Frequency"
                                SelectedIndex="{x:Bind ViewModel.SelectedFrequencyIndex, Mode=TwoWay}"
                                IsEnabled="{x:Bind ViewModel.ScheduledCleanEnabled, Mode=OneWay}"
                                MinWidth="130">
                                <ComboBoxItem Content="Daily" />
                                <ComboBoxItem Content="Weekly" />
                            </ComboBox>

                            <ComboBox
                                Header="Day"
                                SelectedIndex="{x:Bind ViewModel.SelectedWeekdayIndex, Mode=TwoWay}"
                                IsEnabled="{x:Bind ViewModel.ScheduledCleanEnabled, Mode=OneWay}"
                                Visibility="{x:Bind shared:Ui.Visible(ViewModel.IsWeekly), Mode=OneWay}"
                                MinWidth="140">
                                <ComboBoxItem Content="Monday" />
                                <ComboBoxItem Content="Tuesday" />
                                <ComboBoxItem Content="Wednesday" />
                                <ComboBoxItem Content="Thursday" />
                                <ComboBoxItem Content="Friday" />
                                <ComboBoxItem Content="Saturday" />
                                <ComboBoxItem Content="Sunday" />
                            </ComboBox>

                            <ComboBox
                                Header="Time"
                                ItemsSource="{x:Bind ViewModel.Hours}"
                                SelectedIndex="{x:Bind ViewModel.SelectedHourIndex, Mode=TwoWay}"
                                IsEnabled="{x:Bind ViewModel.ScheduledCleanEnabled, Mode=OneWay}"
                                MinWidth="110" />
                        </StackPanel>

                        <CheckBox
                            Content="Move to Recycle Bin"
                            IsChecked="{x:Bind ViewModel.ScheduledCleanRecyclesCheck, Mode=TwoWay}"
                            IsEnabled="{x:Bind ViewModel.ScheduledCleanEnabled, Mode=OneWay}" />

                        <TextBlock
                            Text="Recycled items only free space once that drive's Recycle Bin is emptied."
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <InfoBar
                            Severity="Error"
                            Title="Schedule error"
                            Message="{x:Bind ViewModel.ScheduleError, Mode=OneWay}"
                            IsOpen="{x:Bind shared:Ui.HasText(ViewModel.ScheduleError), Mode=OneWay}"
                            Visibility="{x:Bind shared:Ui.VisibleWhenText(ViewModel.ScheduleError), Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
