<Page
    x:Class="DevDuster.App.SystemCleanup.SystemCleanupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:DevDuster.App.Shared"
    xmlns:s="using:DevDuster.App.SystemCleanup"
    NavigationCacheMode="Required">

    <ScrollViewer Padding="24,16,24,24">
        <StackPanel Spacing="12">
            <TextBlock Text="System" Style="{ThemeResource TitleTextBlockStyle}" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <ProgressRing
                    Width="20"
                    Height="20"
                    IsActive="{x:Bind ViewModel.IsRunning, Mode=OneWay}"
                    Visibility="{x:Bind shared:Ui.Visible(ViewModel.IsRunning), Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="Wrap" />
            </StackPanel>

            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Tasks}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="6" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="s:SystemTaskViewModel">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Detail}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind SizeText, Mode=OneWay}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <Button Grid.Column="2" Content="Clean" Tag="{x:Bind Task}" Click="OnRunClicked" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
    </ScrollViewer>
</Page>
