<Page
    x:Class="DevDuster.App.DeveloperTools.DeveloperToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dt="using:DevDuster.App.DeveloperTools"
    xmlns:shared="using:DevDuster.App.Shared"
    NavigationCacheMode="Required">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Padding="24,16,24,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Developer Tools" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <Button
                Grid.Column="1"
                Content="Cancel"
                Command="{x:Bind ViewModel.CancelScanCommand}"
                Visibility="{x:Bind shared:Ui.Visible(ViewModel.IsScanning), Mode=OneWay}" />
            <Button
                Grid.Column="2"
                Content="{x:Bind ViewModel.ScanButtonLabel, Mode=OneWay}"
                Style="{ThemeResource AccentButtonStyle}"
                Command="{x:Bind ViewModel.StartScanCommand}"
                Visibility="{x:Bind shared:Ui.Collapsed(ViewModel.IsScanning), Mode=OneWay}" />
        </Grid>

        <shared:ScanProgressPanel
            Grid.Row="1"
            Status="{x:Bind ViewModel.Status}"
            Visibility="{x:Bind shared:Ui.Visible(ViewModel.IsScanning), Mode=OneWay}" />

        <ScrollViewer Grid.Row="2" Padding="24,8" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">
                <TextBlock
                    Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Visibility="{x:Bind shared:Ui.Collapsed(ViewModel.HasResults), Mode=OneWay}" />

                <Grid ColumnSpacing="10" Visibility="{x:Bind shared:Ui.Visible(ViewModel.HasResults), Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Measured" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.MeasuredTotalText, Mode=OneWay}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" CornerRadius="8" Padding="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Safe" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.SafeTotalText, Mode=OneWay}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" CornerRadius="8" Padding="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Review" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.ReviewTotalText, Mode=OneWay}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Essential" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.EssentialTotalText, Mode=OneWay}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Other" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.OtherTotalText, Mode=OneWay}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </Grid>

                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Tools, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="12" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="dt:DevToolCardViewModel">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel Spacing="10">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind Root}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Root}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Text="{x:Bind TotalText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                            <TextBlock Text="{x:Bind ShareText}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Tag="{x:Bind Root}" Click="OnRevealClicked" AutomationProperties.Name="Reveal in Explorer" ToolTipService.ToolTip="Reveal in Explorer">
                                            <SymbolIcon Symbol="Folder" />
                                        </Button>
                                    </Grid>

                                    <dt:StackedBar Parts="{x:Bind Parts}" />

                                    <ItemsRepeater ItemsSource="{x:Bind Parts}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Spacing="4" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="dt:DevPartViewModel">
                                                <Grid ColumnSpacing="10" Padding="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="72" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox
                                                        IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                                                        MinWidth="0"
                                                        Visibility="{x:Bind shared:Ui.Visible(IsCleanable)}" />
                                                    <Ellipse
                                                        Width="8"
                                                        Height="8"
                                                        Fill="{x:Bind Brush}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Visibility="{x:Bind shared:Ui.Collapsed(IsCleanable)}" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Title}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{x:Bind SizeText}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Grid.Column="3" Text="{x:Bind KindLabel}" Foreground="{x:Bind Brush}" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>

        <shared:FooterBar
            Grid.Row="3"
            SelectedCount="{x:Bind ViewModel.SelectedCount, Mode=OneWay}"
            SelectedBytes="{x:Bind ViewModel.SelectedBytes, Mode=OneWay}"
            CanSelectAll="{x:Bind ViewModel.CanSelectAll, Mode=OneWay}"
            CanDeselectAll="{x:Bind ViewModel.CanDeselectAll, Mode=OneWay}"
            IsBusy="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
            SelectAllCommand="{x:Bind ViewModel.SelectAllCommand}"
            DeselectAllCommand="{x:Bind ViewModel.DeselectAllCommand}"
            CleanCommand="{x:Bind CleanCommand}" />
    </Grid>
</Page>
