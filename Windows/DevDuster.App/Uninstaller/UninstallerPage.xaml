<Page
    x:Class="DevDuster.App.Uninstaller.UninstallerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:DevDuster.App.Shared"
    xmlns:u="using:DevDuster.App.Uninstaller"
    NavigationCacheMode="Required">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="24,16,24,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="2">
                <TextBlock Text="Uninstaller" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.CountText, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <TextBox
                Grid.Column="1"
                VerticalAlignment="Bottom"
                PlaceholderText="Search installed programs..."
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <ComboBox
                Grid.Column="2"
                Header="Sort"
                SelectedIndex="{x:Bind ViewModel.SelectedSortIndex, Mode=TwoWay}">
                <ComboBoxItem Content="Size" />
                <ComboBoxItem Content="Name" />
            </ComboBox>

            <Button
                Grid.Column="3"
                VerticalAlignment="Bottom"
                Command="{x:Bind ViewModel.RefreshCommand}"
                IsEnabled="{x:Bind shared:Ui.Not(ViewModel.IsLoading), Mode=OneWay}"
                AutomationProperties.Name="Refresh installed programs">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <SymbolIcon Symbol="Refresh" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
        </Grid>

        <InfoBar
            Grid.Row="1"
            Severity="Error"
            Title="Uninstaller error"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            IsOpen="{x:Bind shared:Ui.HasText(ViewModel.ErrorMessage), Mode=OneWay}"
            Visibility="{x:Bind shared:Ui.VisibleWhenText(ViewModel.ErrorMessage), Mode=OneWay}"
            Margin="24,0,24,8" />

        <Pivot Grid.Row="2">
            <PivotItem Header="Programs" Margin="0">
                <Grid>
                    <ProgressRing
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="32"
                        Height="32"
                        IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                        Visibility="{x:Bind shared:Ui.Visible(ViewModel.IsLoading), Mode=OneWay}" />

                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Text="No installed programs matched."
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Visibility="{x:Bind shared:Ui.Collapsed(ViewModel.HasPrograms), Mode=OneWay}" />

                    <ScrollViewer Padding="24,0,24,24" VerticalScrollBarVisibility="Auto" Visibility="{x:Bind shared:Ui.Visible(ViewModel.HasPrograms), Mode=OneWay}">
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Programs, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="6" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="u:ProgramRowViewModel">
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Subtitle}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{x:Bind SizeText}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <Button
                                                Grid.Column="2"
                                                Tag="{x:Bind InstallLocation}"
                                                Click="OnRevealClicked"
                                                Visibility="{x:Bind shared:Ui.Visible(HasInstallLocation)}"
                                                AutomationProperties.Name="Reveal install folder in Explorer"
                                                ToolTipService.ToolTip="Reveal install folder in Explorer">
                                                <SymbolIcon Symbol="Folder" />
                                            </Button>
                                            <Button Grid.Column="3" Content="Uninstall" Tag="{x:Bind Program}" Click="OnUninstallClicked" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                </Grid>
            </PivotItem>

            <PivotItem Header="Leftover folders" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <shared:ScanProgressPanel
                        Status="{x:Bind ViewModel.Status}"
                        Margin="0,0,0,8"
                        Visibility="{x:Bind shared:Ui.Visible(ViewModel.IsSearchingLeftovers), Mode=OneWay}" />

                    <TextBlock
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Text="No leftover folders found."
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Visibility="{x:Bind shared:Ui.Visible(ViewModel.HasNoLeftovers), Mode=OneWay}" />

                    <ScrollViewer Grid.Row="1" Padding="24,0,24,24" VerticalScrollBarVisibility="Auto">
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Leftovers, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="6" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="u:LeftoverRowViewModel">
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{x:Bind IsChecked, Mode=TwoWay}" MinWidth="0" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Path}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Path}" />
                                                <TextBlock Text="{x:Bind Reason}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <ProgressRing Width="14" Height="14" MinWidth="0" MinHeight="0" IsActive="{x:Bind IsDeleting, Mode=OneWay}" Visibility="{x:Bind shared:Ui.Visible(IsDeleting), Mode=OneWay}" />
                                                <TextBlock Text="Deleting…" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Visibility="{x:Bind shared:Ui.Visible(IsDeleting), Mode=OneWay}" />
                                                <TextBlock Text="{x:Bind SizeText}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <Button Grid.Column="3" Tag="{x:Bind Path}" Click="OnRevealClicked" AutomationProperties.Name="Reveal in Explorer" ToolTipService.ToolTip="Reveal in Explorer">
                                                <SymbolIcon Symbol="Folder" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>

                    <shared:FooterBar
                        Grid.Row="2"
                        ActionTitle="Remove"
                        SelectedCount="{x:Bind ViewModel.SelectedCount, Mode=OneWay}"
                        SelectedBytes="{x:Bind ViewModel.SelectedBytes, Mode=OneWay}"
                        CanSelectAll="{x:Bind shared:Ui.Not(ViewModel.HasNoLeftovers), Mode=OneWay}"
                        CanDeselectAll="{x:Bind shared:Ui.Not(ViewModel.HasNoLeftovers), Mode=OneWay}"
                        IsBusy="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                        Progress="{x:Bind ViewModel.CleanProgress}"
                        SelectAllCommand="{x:Bind ViewModel.SelectAllCommand}"
                        DeselectAllCommand="{x:Bind ViewModel.DeselectAllCommand}"
                        CleanCommand="{x:Bind RemoveLeftoversCommand}" />
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
