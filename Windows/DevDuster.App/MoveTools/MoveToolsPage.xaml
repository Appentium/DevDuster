<Page
    x:Class="DevDuster.App.MoveTools.MoveToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mt="using:DevDuster.App.MoveTools"
    xmlns:relocate="using:DevDuster.Core.Relocate"
    xmlns:shared="using:DevDuster.App.Shared"
    NavigationCacheMode="Required">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="24,16,24,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Move Tools" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <Button
                Grid.Column="1"
                Command="{x:Bind ViewModel.LoadCommand}"
                IsEnabled="{x:Bind shared:Ui.Not(ViewModel.IsMoving), Mode=OneWay}"
                AutomationProperties.Name="Refresh tools">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <SymbolIcon Symbol="Refresh" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="24,0,24,24" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Move tool data to another NTFS or ReFS drive safely" FontWeight="SemiBold" />
                        <TextBlock
                            Text="DevDuster copies the folder, verifies every file, leaves a junction at the original path so tools keep working, and deletes the old copy only after verification."
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <InfoBar
                    Severity="Success"
                    Title="Move complete"
                    Message="{x:Bind ViewModel.ResultMessage, Mode=OneWay}"
                    IsOpen="{x:Bind shared:Ui.HasText(ViewModel.ResultMessage), Mode=OneWay}"
                    Visibility="{x:Bind shared:Ui.VisibleWhenText(ViewModel.ResultMessage), Mode=OneWay}" />

                <InfoBar
                    Severity="Warning"
                    Title="Leftover folder couldn't be removed"
                    Message="{x:Bind ViewModel.LeftoverPath, Mode=OneWay}"
                    IsOpen="{x:Bind shared:Ui.HasText(ViewModel.LeftoverPath), Mode=OneWay}"
                    Visibility="{x:Bind shared:Ui.VisibleWhenText(ViewModel.LeftoverPath), Mode=OneWay}">
                    <InfoBar.ActionButton>
                        <Button Content="Reveal in Explorer" Click="OnRevealLeftoverClicked" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <InfoBar
                    Severity="Error"
                    Title="Move error"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    IsOpen="{x:Bind shared:Ui.HasText(ViewModel.ErrorMessage), Mode=OneWay}"
                    Visibility="{x:Bind shared:Ui.VisibleWhenText(ViewModel.ErrorMessage), Mode=OneWay}" />

                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14"
                    Visibility="{x:Bind shared:Ui.Visible(ViewModel.IsMoving), Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock Text="{x:Bind ViewModel.MoveTitle, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button HorizontalAlignment="Right" Content="Cancel" Command="{x:Bind ViewModel.CancelMoveCommand}" />
                        </Grid>
                        <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind ViewModel.MoveProgress, Mode=OneWay}" />
                        <TextBlock
                            Text="Copying and verifying files. Nothing changes until verification succeeds."
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14"
                    Visibility="{x:Bind shared:Ui.Visible(ViewModel.HasMovedTools), Mode=OneWay}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Moved Tools" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.MovedTools, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="8" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="mt:MovedToolViewModel">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind PathsText}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{x:Bind StatusText}" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Button Grid.Column="2" Tag="{x:Bind Destination}" Click="OnRevealClicked" IsEnabled="{x:Bind IsConnected}" AutomationProperties.Name="Reveal moved folder in Explorer" ToolTipService.ToolTip="Reveal in Explorer">
                                            <SymbolIcon Symbol="Folder" />
                                        </Button>
                                        <Button Grid.Column="3" Content="Move Back" Tag="{x:Bind Relocation}" Click="OnMoveBackClicked" IsEnabled="{x:Bind IsConnected}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock Text="Folders You Can Move" Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <ProgressRing HorizontalAlignment="Right" Width="18" Height="18" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Visibility="{x:Bind shared:Ui.Visible(ViewModel.IsLoading), Mode=OneWay}" />
                        </Grid>

                        <ListView
                            ItemsSource="{x:Bind ViewModel.MovableTargets, Mode=OneWay}"
                            SelectedIndex="{x:Bind ViewModel.SelectedTargetIndex, Mode=TwoWay}"
                            IsEnabled="{x:Bind shared:Ui.Not(ViewModel.IsMoving), Mode=OneWay}"
                            MaxHeight="280">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="mt:MoveTargetViewModel">
                                    <Grid ColumnSpacing="12" Padding="4,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind Path}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{x:Bind SizeText, Mode=OneWay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Expander Header="Can't be moved here" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Visibility="{x:Bind shared:Ui.Visible(ViewModel.HasBlockedTargets), Mode=OneWay}">
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.BlockedTargets, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="6" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="relocate:RelocationTarget">
                                        <StackPanel Spacing="2" Padding="4">
                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind BlockedReason}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </Expander>
                    </StackPanel>
                </Border>

                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14"
                    Visibility="{x:Bind shared:Ui.Visible(ViewModel.HasSelection), Mode=OneWay}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Destination" Style="{ThemeResource SubtitleTextBlockStyle}" />

                        <ComboBox
                            Header="Target Drive (NTFS / ReFS)"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{x:Bind ViewModel.AvailableDrives, Mode=OneWay}"
                            SelectedIndex="{x:Bind ViewModel.SelectedDriveIndex, Mode=TwoWay}"
                            IsEnabled="{x:Bind shared:Ui.Not(ViewModel.IsMoving), Mode=OneWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="mt:MoveDriveChoice">
                                    <TextBlock Text="{x:Bind DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                Header="Destination Folder"
                                Text="{x:Bind ViewModel.DestinationPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                IsEnabled="{x:Bind shared:Ui.Not(ViewModel.IsMoving), Mode=OneWay}" />
                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Content="Choose..."
                                Click="OnChooseDestinationClicked"
                                IsEnabled="{x:Bind shared:Ui.Not(ViewModel.IsMoving), Mode=OneWay}" />
                        </Grid>

                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.CheckProblems, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="4" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{x:Bind}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.CheckNotes, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="4" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{x:Bind}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <Button
                            HorizontalAlignment="Right"
                            Content="Move..."
                            Style="{ThemeResource AccentButtonStyle}"
                            Click="OnMoveClicked"
                            IsEnabled="{x:Bind ViewModel.CanMove, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
