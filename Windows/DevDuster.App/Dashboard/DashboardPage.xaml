<Page
    x:Class="DevDuster.App.Dashboard.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="using:DevDuster.App.Dashboard"
    xmlns:shared="using:DevDuster.App.Shared"
    NavigationCacheMode="Required">

    <Grid RowSpacing="16" Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="Dashboard" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.LastCleanedText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Button
                Grid.Column="1"
                Command="{x:Bind ViewModel.RefreshCommand}"
                IsEnabled="{x:Bind shared:Ui.Not(ViewModel.IsLoading), Mode=OneWay}"
                AutomationProperties.Name="Refresh dashboard">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <SymbolIcon Symbol="Refresh" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
            <Button
                Grid.Column="2"
                Style="{ThemeResource AccentButtonStyle}"
                Command="{x:Bind ViewModel.ScanJunkCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <SymbolIcon Symbol="Find" />
                    <TextBlock Text="Scan for Junk" />
                </StackPanel>
            </Button>
        </Grid>

        <InfoBar
            Grid.Row="1"
            Severity="Error"
            Title="Error"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            IsOpen="{x:Bind shared:Ui.HasText(ViewModel.ErrorMessage), Mode=OneWay}"
            Visibility="{x:Bind shared:Ui.VisibleWhenText(ViewModel.ErrorMessage), Mode=OneWay}" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" Padding="0,0,8,0">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Reclaimable Now" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.ReclaimableTotalText, Mode=OneWay}" Style="{ThemeResource TitleTextBlockStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Freed This Week" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.ThisWeekFreedText, Mode=OneWay}" Style="{ThemeResource TitleTextBlockStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Freed All Time" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.TotalFreedText, Mode=OneWay}" Style="{ThemeResource TitleTextBlockStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="In Recycle Bin" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.TotalRecycleText, Mode=OneWay}" Style="{ThemeResource TitleTextBlockStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Reclaimable by Tier" Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <StackPanel Spacing="10" Visibility="{x:Bind shared:Ui.Visible(ViewModel.HasScan), Mode=OneWay}">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" CornerRadius="6" Padding="10,8">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Safe" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.SafeReclaimableText, Mode=OneWay}" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" CornerRadius="6" Padding="10,8">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Review" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.ReviewReclaimableText, Mode=OneWay}" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" CornerRadius="6" Padding="10,8">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Caution" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.CautionReclaimableText, Mode=OneWay}" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Button Content="Review in Cleaner" Command="{x:Bind ViewModel.OpenCleanerCommand}" />
                            </StackPanel>
                            <StackPanel Spacing="10" Visibility="{x:Bind shared:Ui.Collapsed(ViewModel.HasScan), Mode=OneWay}">
                                <TextBlock
                                    Text="Run a scan to see how much space caches, logs, and stale build artifacts use."
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                                <Button Content="Scan for Junk" Style="{ThemeResource AccentButtonStyle}" Command="{x:Bind ViewModel.ScanJunkCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="12">
                            <Grid>
                                <TextBlock Text="Cleaning Activity" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Text="Last 8 weeks"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.WeeklyBars, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout MaximumRowsOrColumns="8" MinItemWidth="44" MinColumnSpacing="8" Orientation="Horizontal" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="d:WeekBarModel">
                                        <StackPanel Spacing="4" VerticalAlignment="Bottom" ToolTipService.ToolTip="{x:Bind ToolTipText}">
                                            <Grid Height="116">
                                                <Border
                                                    VerticalAlignment="Bottom"
                                                    Height="{x:Bind BarHeight}"
                                                    Background="{ThemeResource SystemFillColorSuccessBrush}"
                                                    CornerRadius="4" />
                                            </Grid>
                                            <TextBlock
                                                Text="{x:Bind Label}"
                                                HorizontalAlignment="Center"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Text="Drives" Style="{ThemeResource SubtitleTextBlockStyle}" />

                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Drives, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MaximumRowsOrColumns="2" MinItemWidth="340" MinColumnSpacing="12" MinRowSpacing="12" Orientation="Horizontal" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="d:DriveCardModel">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel Spacing="10">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <Border Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{x:Bind FormatText}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                        <Border Grid.Column="2" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{x:Bind DriveTag}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                    </Grid>

                                    <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind UsedPercent}" />

                                    <TextBlock Text="{x:Bind SpaceSummary}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                    <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                                        <Grid>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Recycle Bin" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind RecycleText}" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <Button
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Content="Empty Recycle Bin"
                                                Tag="{x:Bind}"
                                                Click="OnEmptyRecycleBinClicked"
                                                IsEnabled="{x:Bind CanEmpty}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
