<Page
    x:Class="DevDuster.App.LargeFiles.LargeFilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lf="using:DevDuster.App.LargeFiles"
    xmlns:shared="using:DevDuster.App.Shared"
    NavigationCacheMode="Required">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Padding="24,16,24,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Large Files" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" Header="Min Size" SelectedIndex="{x:Bind ViewModel.SelectedMinSizeIndex, Mode=TwoWay}">
                <ComboBoxItem Content="100 MB" />
                <ComboBoxItem Content="500 MB" />
                <ComboBoxItem Content="1 GB" />
                <ComboBoxItem Content="5 GB" />
            </ComboBox>
            <ComboBox Grid.Column="2" Header="Older Than" SelectedIndex="{x:Bind ViewModel.SelectedAgeIndex, Mode=TwoWay}">
                <ComboBoxItem Content="Any age" />
                <ComboBoxItem Content="30+ days" />
                <ComboBoxItem Content="90+ days" />
                <ComboBoxItem Content="365+ days" />
            </ComboBox>
            <ComboBox
                Grid.Column="3"
                Header="Sort"
                SelectedIndex="{x:Bind ViewModel.SelectedSortIndex, Mode=TwoWay}"
                Visibility="{x:Bind shared:Ui.Visible(ViewModel.HasResults), Mode=OneWay}">
                <ComboBoxItem Content="Size" />
                <ComboBoxItem Content="Name" />
            </ComboBox>
            <Button
                Grid.Column="4"
                VerticalAlignment="Bottom"
                Content="Cancel"
                Command="{x:Bind ViewModel.CancelScanCommand}"
                Visibility="{x:Bind shared:Ui.Visible(ViewModel.IsScanning), Mode=OneWay}" />
            <Button
                Grid.Column="5"
                VerticalAlignment="Bottom"
                Content="{x:Bind ViewModel.ScanButtonLabel, Mode=OneWay}"
                Style="{ThemeResource AccentButtonStyle}"
                Command="{x:Bind ViewModel.StartScanCommand}"
                Visibility="{x:Bind shared:Ui.Collapsed(ViewModel.IsScanning), Mode=OneWay}" />
        </Grid>

        <Border
            Grid.Row="1"
            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
            Padding="24,8"
            Visibility="{x:Bind shared:Ui.Visible(ViewModel.IsScanning), Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <ProgressRing IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}" Width="18" Height="18" />
                <TextBlock
                    Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" Padding="24,8" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <TextBlock
                    Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Visibility="{x:Bind shared:Ui.Collapsed(ViewModel.HasResults), Mode=OneWay}" />

                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Files, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="6" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="lf:LargeFileRowViewModel">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{x:Bind IsChecked, Mode=TwoWay}" MinWidth="0" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind DirectoryPath}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind FullPath}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind ModifiedText}" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind SizeText}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <Button Grid.Column="4" Tag="{x:Bind FullPath}" Click="OnRevealClicked" AutomationProperties.Name="Reveal in Explorer" ToolTipService.ToolTip="Reveal in Explorer">
                                        <SymbolIcon Symbol="Folder" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>

        <shared:FooterBar
            Grid.Row="3"
            SelectedCount="{x:Bind ViewModel.SelectedCount, Mode=OneWay}"
            SelectedBytes="{x:Bind ViewModel.SelectedBytes, Mode=OneWay}"
            CanSelectAll="{x:Bind ViewModel.CanSelectAll, Mode=OneWay}"
            CanDeselectAll="{x:Bind ViewModel.CanDeselectAll, Mode=OneWay}"
            IsBusy="{x:Bind ViewModel.IsCleaning, Mode=OneWay}"
            SelectAllCommand="{x:Bind ViewModel.SelectAllCommand}"
            DeselectAllCommand="{x:Bind ViewModel.DeselectAllCommand}"
            CleanCommand="{x:Bind CleanCommand}" />
    </Grid>
</Page>
