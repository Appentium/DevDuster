<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- Always on: the self-contained app ships this exe, and the SDK rejects a framework-dependent one. -->
    <SelfContained>true</SelfContained>
    <AssemblyName>duster</AssemblyName>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DevDuster.Platform\DevDuster.Platform.csproj" />
  </ItemGroup>
</Project>
